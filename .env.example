NODE_ENV=development
# In production, replace this with a private random value (at least 32 bytes).
AUTH_SECRET=local-development-secret-change-before-production

# Public URLs used by the browser.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Internal service URLs.
GRAPHQL_URL=http://localhost:4000/graphql
TRIP_SERVICE_URL=http://localhost:4010
BOOKING_SERVICE_URL=http://localhost:4020
AI_SERVICE_URL=http://localhost:4100
ANALYTICS_SERVICE_URL=http://localhost:4050
SEAT_GRPC_URL=localhost:50051
TRIP_GRPC_BIND=0.0.0.0:50052
BOOKING_GRPC_BIND=0.0.0.0:50053
GATEWAY_GRPC_BIND=0.0.0.0:50054
MCP_GRPC_BIND=0.0.0.0:50055

# Infrastructure. The project runs with in-memory fallbacks if these are absent.
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092

# PostgreSQL. Docker Compose provisions a separate logical database per owner service.
POSTGRES_USER=bus
POSTGRES_PASSWORD=bus_dev_password
TRIP_DATABASE_URL=postgresql://bus:bus_dev_password@localhost:5432/trip_db
BOOKING_DATABASE_URL=postgresql://bus:bus_dev_password@localhost:5432/booking_db
SEAT_DATABASE_URL=postgresql://bus:bus_dev_password@localhost:5432/seat_db
ANALYTICS_DATABASE_URL=postgresql://bus:bus_dev_password@localhost:5432/analytics_db

# AI SDK. Leave empty to use the deterministic rule-based assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
