NODE_ENV=development
# In production, replace this with a private random value (at least 32 bytes).
AUTH_SECRET=local-development-secret-change-before-production

# Public URLs used by the browser.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Internal service URLs.
GRAPHQL_URL=http://localhost:4000/graphql
TRIP_SERVICE_URL=http://localhost:4010
BOOKING_SERVICE_URL=http://localhost:4020
AI_SERVICE_URL=http://localhost:4100
ANALYTICS_SERVICE_URL=http://localhost:4050
SEAT_GRPC_URL=localhost:50051
TRIP_GRPC_BIND=0.0.0.0:50052
BOOKING_GRPC_BIND=0.0.0.0:50053
GATEWAY_GRPC_BIND=0.0.0.0:50054
MCP_GRPC_BIND=0.0.0.0:50055

# Infrastructure. The project runs with in-memory fallbacks if these are absent.
DATABASE_URL=postgresql://bus:bus@localhost:5432/bus_ticketing
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
PENDING_PAYMENT_TTL_SECONDS=300

# Outbound e-ticket email for guest bookings after successful payment. Leave
# SMTP_URL blank in local development; the email worker retains the generated
# message under data/emails instead. URL-encode special characters in credentials.
# Examples: smtp://username:app-password@smtp.example.com:587
#           smtps://username:app-password@smtp.example.com:465
SMTP_URL=
SMTP_FROM="Bus AI Tickets <no-reply@bus-ai.local>"
PUBLIC_WEB_URL=http://localhost

# PostgreSQL. Docker Compose provisions a separate logical database per owner service.
POSTGRES_USER=bus
POSTGRES_PASSWORD=bus
TRIP_DATABASE_URL=postgresql://bus:bus@localhost:5432/trip_db
BOOKING_DATABASE_URL=postgresql://bus:bus@localhost:5432/booking_db
SEAT_DATABASE_URL=postgresql://bus:bus@localhost:5432/seat_db
ANALYTICS_DATABASE_URL=postgresql://bus:bus@localhost:5432/analytics_db

# Security controls. Replace callback secret outside local development.
PAYMENT_CALLBACK_SECRET=local-payment-callback-secret-change-me
GRAPHQL_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3001
GRAPHQL_RATE_LIMIT=120
ALLOW_GRAPHQL_INTROSPECTION=false
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=500

# AI SDK. Leave empty to use the deterministic rule-based assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# GitHub Models alternative. Put real secrets in .env.local, never commit them.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_CHAT_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small
